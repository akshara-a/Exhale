# ====================================================================
# Exhale Grounding Protocol - Backend Environment Template
# ====================================================================
# Copy this file to .env and configure local overrides.
# NOTE: Never commit .env files containing real keys to version control.

# Server Port
PORT=8000

# Allowed CORS Origins (comma-separated list of trusted client origins)
# In production, replace with your frontend URL(s), e.g. https://exhale.onrender.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Inference Cascade Configuration
# Tier 1: Local Ollama
ENABLE_OLLAMA=false
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_MODEL=hermes3:latest
OLLAMA_TIMEOUT=30.0

# Tier 2: Open-Weight Cloud Fallback (Groq)
GROQ_API_KEY=
GROQ_MODEL=auto

# Request Timeout Deadline (seconds)
REQUEST_TIMEOUT=60.0

# Force Deterministic In-Memory Fallback (1 for test/offline, 0 for live inference)
FORCE_FALLBACK=0
